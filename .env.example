# Copy to .env (or set these in your host's dashboard). NEVER commit the real values.
PORT=3000

# Persistent folder for WhatsApp sessions + bot settings. On a host, point this at a persistent disk,
# otherwise every redeploy logs everyone out.
DATA_DIR=./data

# Protects /reconnect and /connect-all (send it in the x-admin-token header). Empty = those routes are disabled.
ADMIN_TOKEN=

# The developer number is always an owner. Add extra owners (digits only, comma separated).
DEVELOPER_NUMBER=263789846423
OWNER_NUMBERS=
PREFIX=.

# Set to false to stop auto-joining the Whitekid group + channels after a number is paired.
AUTO_JOIN=true

# Telegram pairing bot (leave empty to turn it off)
TG_TOKEN=

# APIs
PAXSENIX_API_KEY=
NEWS_API_KEY=
OPENAI_API_KEY=
TMDB_API_KEY=

# AI (recommended): any OpenAI-compatible service gives the most reliable answers for every AI command.
# Without it the bot falls back to free public endpoints, which can be slow or down.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional
# Font on bot messages: small (default, ᴛɪɴʏ ꜱᴍᴀʟʟ ᴄᴀᴘꜱ), bold (labels only) or none
BOT_FONT=small
# Shown in .repo if set
BOT_REPO_URL=
LOG_LEVEL=silent
MAX_RECONNECTS=8
# Switch the WhatsApp library, e.g. WA_LIB=@whiskeysockets/baileys
WA_LIB=
# Render keep-alive (Render sets RENDER_EXTERNAL_URL itself)
RENDER_KEEP_ALIVE_URL=
OPENWEATHER_KEY=

# Auto-update from GitHub. Put your BOT repo here (owner/name or the GitHub URL). Empty = auto-update off.
# The bot checks every few minutes, downloads new files, keeps data/ + .env + sessions, and restarts itself.
UPDATE_REPO=
UPDATE_BRANCH=main
UPDATE_INTERVAL_MIN=5
AUTO_UPDATE=true
# Only needed if the repo is private (a read-only token with "Contents: read")
GITHUB_TOKEN=
